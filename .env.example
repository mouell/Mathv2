# ============================
# MathV2 Environment Variables
# ============================

# Database
DATABASE_URL="postgresql://mathv2:mathv2_secret_2024@localhost:5432/mathv2"

# JWT
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars"
JWT_EXPIRES_IN="7d"

# AI Engine (100% local — no external API required)
AI_ENGINE_URL="http://localhost:8001"

# File Storage
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE_MB=50

# Backend
PORT=3001
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_AI_ENGINE_URL="http://localhost:8001"
NEXT_PUBLIC_APP_NAME="MathV2"
NEXT_PUBLIC_APP_VERSION="1.0.0"
