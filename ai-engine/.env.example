# MathV2 AI Engine - Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key (optional - for AI-enhanced analysis)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# File Upload Settings
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=/tmp/mathv2_uploads
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,bmp,dxf,dwg

# OCR Settings
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGES=fra+eng+osd
OCR_DPI=300

# Processing Settings
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT_SECONDS=300

# G-Code Defaults
DEFAULT_CONTROLLER=fanuc
DEFAULT_WORK_OFFSET=G54
DEFAULT_UNITS=metric

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/mathv2/ai-engine.log
